# ─── Application ─────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=10000

# Public URL of this backend service on Render — MUST be set correctly
# This is used to build image upload URLs, email unsubscribe links, etc.
# e.g. https://arsa-1.onrender.com
API_URL=https://your-backend.onrender.com

# Public URL of the frontend static site on Render
# e.g. https://arsa-8dy1.onrender.com
CLIENT_URL=https://your-frontend.onrender.com

# ─── Database (TiDB Cloud / PlanetScale / any MySQL) ─────────────────────────
# TiDB Cloud format (SSL auto-detected):
DATABASE_URL=mysql://user:password@host:4000/arsa_realestate

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_64_char_random_hex
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=replace_with_another_64_char_random_hex
JWT_REFRESH_EXPIRE=30d

# ─── Rate limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200

# ─── Email (SMTP via Gmail) ───────────────────────────────────────────────────
# Use a Gmail App Password — NOT your regular Gmail password
# Generate at: https://myaccount.google.com/apppasswords
# IMPORTANT: Do NOT wrap the password in quotes
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASSWORD=your_app_password_no_quotes
# Gmail requires FROM to match the authenticated SMTP_USER
SMTP_FROM=your@gmail.com

# ─── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=info
